{
  "_leia": [
    "The smallest working example of Doc First. Copy this folder, swap the owner for your e-mail,",
    "and you have reviewable documentation running.",
    "",
    "  docker run -p 8080:8080 -v dados:/dados \\",
    "    -v $PWD/examples/ola-mundo:/conteudo -e REVISAO_SITE=/conteudo \\",
    "    -e REVISAO_OWNER=you@example.org doc-first"
  ],

  "nome": "Hello world",
  "owner": "you@example.org",

  "conteudo": {
    "pastas": ["paginas"],
    "registro": "aprovacoes.json",
    "inicio": "/paginas/A01.html",
    "recortar": "paginas/",
    "exemplosDePagina": "A01 or A02"
  }
}
